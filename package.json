{
  "name": "truckcontrol-ai",
  "private": true,
  "version": "0.5.3-rc.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:companies": "node scripts/test-companies.mjs",
    "test:e2e:saas": "node scripts/test-saas.mjs",
    "test:e2e:candidate": "node scripts/test-candidate.mjs",
    "verify:published": "node scripts/verify-published-candidate.mjs",
    "verify:retained": "node scripts/verify-retained-tests.mjs",
    "check": "npm run verify:retained && npm run typecheck && npm test && npm run build",
    "build:candidate": "node scripts/build-candidate.mjs",
    "build:production": "node scripts/build-production.mjs",
    "test:e2e:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "postal-mime": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "svix": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
