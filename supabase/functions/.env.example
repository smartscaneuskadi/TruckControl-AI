# Secrets del proyecto independiente truckcontrol-ai; nunca variables VITE_.
TRUCKCONTROL_APP_ORIGIN=https://truckcontrolai.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave AES-256 de 32 bytes aleatorios, codificada en base64; generar en el servidor.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Alternativa segura preparada: tres secretos propios en Supabase Vault.
# Ver docs/MAIL_SETUP.md. No mezclar clientes OAuth ni rotar claves con tokens existentes.
# No se activa consumo aunque exista una clave. Requiere autorización de costes.
INVOICE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=
DOCUMENT_AI_ENABLED=false
OPENAI_DOCUMENT_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Independent recurring gateway: all four settings are required before checkout.
# Keep disabled until the owner approves provider charges and published terms.
BILLING_RECURRING_ENABLED=false
STRIPE_RECURRING_WEBHOOK_SECRET=
BILLING_TERMS_VERSION=
BILLING_TERMS_URL=
